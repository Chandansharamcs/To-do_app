<?xml version="1.0" encoding="utf-8"?>
<!-- v80: one widget, matching the 4x2 cell he actually has.

     minWidth/minHeight are what the launcher reserves, expressed in dp at the
     old formula of 70dp per cell:
       4 cells wide  = 4 * 70 - 30 = 250dp
       3 cells tall  = 3 * 70 - 30 = 180dp standing, 150dp minimum
     because the quest list below needs room to be scrollable at all
     targetCellWidth/Height do the same job on Android 12+ and are what modern
     launchers honour; both are set so the two rules agree.

     updatePeriodMillis stays 0: its floor is 30 minutes and the countdown
     needs one, so WidgetProvider arms its own repeating alarm instead. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:initialLayout="@layout/widget_routine"
    android:minWidth="250dp"
    android:minHeight="150dp"
    android:minResizeWidth="180dp"
    android:minResizeHeight="150dp"
    android:targetCellWidth="4"
    android:targetCellHeight="3"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:description="@string/widget_description"
    android:previewLayout="@layout/widget_routine"
    android:updatePeriodMillis="0" />
