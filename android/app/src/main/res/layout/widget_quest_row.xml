<?xml version="1.0" encoding="utf-8"?>
<!-- v81: one quest in the scrolling list. Tapping the row ticks it; the row
     carries the tap target so the ✓ does not have to be hit precisely. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/quest_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="10dp"
    android:paddingEnd="10dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:background="@drawable/widget_row_bg">

    <TextView
        android:id="@+id/quest_dot"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:maxLines="1"
        android:textColor="#FF5EEAD4"
        android:text="○" />

    <TextView
        android:id="@+id/quest_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="9dp"
        android:textSize="12sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="#FFE4F2FA"
        android:text="quest" />

    <TextView
        android:id="@+id/quest_coins"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:textSize="10sp"
        android:maxLines="1"
        android:textColor="#99CFE8F5"
        android:text="" />
</LinearLayout>
