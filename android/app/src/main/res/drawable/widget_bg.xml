<?xml version="1.0" encoding="utf-8"?>
<!-- v78: the terminal glass panel.
     RemoteViews cannot blur. There is no backdrop filter in a widget, and the
     launcher owns whatever is behind us, so glass here is the readable part of
     the look: a translucent near-black plate, a 1dp teal hairline, and corners
     round enough to read as a pane rather than a card. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#CC0B0D10" />
    <stroke
        android:width="1dp"
        android:color="#4D5EEAD4" />
    <corners android:radius="18dp" />
</shape>
