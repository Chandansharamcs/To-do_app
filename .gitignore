# ─── dependencies ──────────────────────────────────────────────
node_modules/
worker/node_modules/

# ─── build artifacts ───────────────────────────────────────────
# NOTE: bundle.js is intentionally COMMITTED — GitHub Pages serves
# it directly with no build step. Do not add it here.
*.map
dist/
.esbuild/

# ─── cloudflare / wrangler ─────────────────────────────────────
.wrangler/
worker/.wrangler/
.dev.vars
worker/.dev.vars

# ─── secrets (belt & braces — these should never exist here) ───
.env
.env.*
*.pem
*vapid*private*

# ─── native app build output (v76) ─────────────────────────────
# android/ IS committed: the gradle wrapper + manifest + icons are the project.
# What is not committed is anything generated by a build.
app-web/
android/app/build/
android/build/
android/.gradle/
android/local.properties
*.jks
*.keystore

# ─── editor / os ───────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*~

# ─── logs & scratch ────────────────────────────────────────────
*.log
npm-debug.log*
.cache/
tmp/
